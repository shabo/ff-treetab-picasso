{
  "name": "tree-tab-picasso",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:emoji": "node scripts/gen_emoji_data.mjs",
    "bump:version": "node scripts/bump_version.mjs",
    "start": "NO_UPDATE_NOTIFIER=1 web-ext run -s src",
    "build": "NO_UPDATE_NOTIFIER=1 web-ext build -s src -a dist --overwrite-dest",
    "lint": "eslint . && prettier --check .",
    "lint:ext": "node scripts/lint_ext.mjs",
    "format": "prettier --write .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0"
  }
}
